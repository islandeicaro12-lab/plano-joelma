rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Comprovantes: quem usa o app pode enviar e ver,
    // mas ninguém altera ou apaga um comprovante já enviado.
    match /comprovantes/{id} {
      allow read, create: if request.auth != null;
    }

    // Dados do app
    match /membros/{id}    { allow read, write: if request.auth != null; }
    match /pagamentos/{id} { allow read, write: if request.auth != null; }
    match /consultas/{id}  { allow read, write: if request.auth != null; }
    match /meses/{id}      { allow read, write: if request.auth != null; }
    match /config/{id}     { allow read, write: if request.auth != null; }
    match /extras/{id}     { allow read, write: if request.auth != null; }
    match /pagextras/{id}  { allow read, write: if request.auth != null; }
  }
}
